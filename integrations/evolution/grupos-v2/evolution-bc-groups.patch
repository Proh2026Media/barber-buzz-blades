+import type { PrismaClient } from '@prisma/client';
+
+import type { OperationStore } from './core';
+
+/** Restrição única no banco: nenhuma posse em memória nem retry após início incerto. */
+export function operationStore(db: PrismaClient): OperationStore {
+  return {
+    lock: async (instanceId, token) => {
+      try {
+        await db.bcGroupLease.create({ data: { instanceId, token } });
+        return true;
+      } catch (error) {
+        if (error?.code === 'P2002') return false;
+        throw error;
+      }
+    },
+    unlock: async (instanceId, token) => {
+      await db.bcGroupLease.deleteMany({ where: { instanceId, token } });
+    },
+    accepted: async (instanceId, operationKey, messageId) => {
+      await db.bcGroupOperation.update({
+        where: { instanceId_operationKey: { instanceId, operationKey } },
+        data: { state: 'code_accepted', messageId },
+      });
+    },
+    find: (instanceId, operationKey) =>
+      db.bcGroupOperation.findUnique({ where: { instanceId_operationKey: { instanceId, operationKey } } }),
+    claim: async (data) => {
+      try {
+        await db.bcGroupOperation.create({ data });
+        return true;
+      } catch (error) {
+        if (error?.code === 'P2002') return false;
+        throw error;
+      }
+    },
+    created: async (instanceId, operationKey, groupJid) => {
+      await db.bcGroupOperation.update({
+        where: { instanceId_operationKey: { instanceId, operationKey } },
+        data: { state: 'created', groupJid },
+      });
+    },
+  };
+}
