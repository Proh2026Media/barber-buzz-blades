+  extensionEnabled,
+  configuredPlatformJids,
+  eventEnvelope,
+  type Dependencies,
+  type Operation,
+} from '../src/api/integrations/channel/whatsapp/bc-groups/core';
+const shop = 'bc-ficticia',
+  self = '5511888888888@s.whatsapp.net',
+  other = '5511777777777@s.whatsapp.net',
+  jid = '12345-67890@g.us',
+  operationId = '11111111-1111-4111-8111-111111111111';
+process.env.BC_GROUPS_EXTENSION_ENABLED = 'true';
+process.env.BC_GROUPS_INSTANCES = shop;
+const request = { operationId, subject: 'Atendimento fictício', participants: [] };
+function fixture() {
+  const rows = new Map<string, Operation>();
+  let creates = 0;
+  let locked=false;
+  let metadata: any = {
+    id: jid,
+    subject: 'Nome',
+    owner: self,
+    restrict: true,
+    memberAddMode: false,
+    joinApprovalMode: true,
+    participants: [{ id: self, admin: 'superadmin' }],
+  };
+  const socket = {
+    groupMetadata: async () => metadata,
+    groupCreate: async () => {
+      creates++;
+      await new Promise((r) => setTimeout(r, 5));
+      return metadata;
+    },
+    groupMemberAddMode: async (_jid: string, mode: string) => {
+      metadata.memberAddMode = mode === 'all_member_add';
+    },
+    groupJoinApprovalMode: async (_jid: string, mode: string) => {
+      metadata.joinApprovalMode = mode === 'on';
+    },
+    groupRequestParticipantsList: async () => [{ jid: other }],
+    groupRequestParticipantsUpdate: async (_jid: string, ids: string[], action: string) =>
+      ids.map((jid) => ({ jid, status: action })),
+  };
+  const d: Dependencies = {
+    instanceId: 'id-ficticio',
+    instanceName: shop,
+    socket: socket as Dependencies['socket'],
+    self: () => [self],
+    ready: () => true,
+    platformJids: [self],
+    store: {
+      lock: async()=>{if(locked)return false;locked=true;return true;}, unlock: async()=>{locked=false;},
+      accepted: async(i,k,messageId)=>{Object.assign(rows.get(i+k)!,{state:'code_accepted',messageId});},
+      find: async (i, k) => rows.get(i + k) ?? null,
+      claim: async (row) => {
+        const k = row.instanceId + row.operationKey;
+        if (rows.has(k)) return false;
+        rows.set(k, { ...row });
+        return true;
+      },
+      created: async (i, k, g) => {
+        Object.assign(rows.get(i + k)!, { state: 'created', groupJid: g });
+      },
+    },
+  };
+  return {
+    d,
+    socket,
+    rows,
+    get creates() {
+      return creates;
+    },
+    get metadata() {
+      return metadata;
+    },
+  };
+}
+const rejects = (fn: () => Promise<unknown>, status: number) => assert.rejects(fn, (e: any) => e.status === status);
+test('Flag nasce desligada e instância fora da lista não é habilitada', () => {
+  assert.equal(extensionEnabled(shop, {}), false);
+  assert.equal(extensionEnabled('outra'), false);
+  assert.deepEqual(configuredPlatformJids(shop, { BC_GROUPS_PLATFORM_JIDS: 'invalido' }), []);
+});
+test('Instância não autorizada não chega ao provedor', async () => {
+  const f = fixture();
+  f.d.instanceName = 'outra';
+  await rejects(() => executeGroupCommand(f.d, 'create', request), 503);
+  assert.equal(f.creates, 0);
+});
+test('Número não pertencente à Plataforma não cria', async () => {
+  const f = fixture();
+  f.d.platformJids = [];
+  await rejects(() => executeGroupCommand(f.d, 'create', request), 503);
+  assert.equal(f.creates, 0);
