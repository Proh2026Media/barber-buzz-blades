@@ -0,0 +1,72 @@
+import { timingSafeEqual } from 'node:crypto';
+
+import type { RequestHandler, Router } from 'express';
+import { validate } from 'jsonschema';
+
+import { extensionEnabled } from '../integrations/channel/whatsapp/bc-groups/core';
+import { bcGroupSchemas } from './bc-group.schemas';
+
+/** Reutiliza todas as guardas existentes. Query/body nunca escolhem a instância autenticada. */
+export function registerBcGroupRoutes(
+  router: Router,
+  guards: RequestHandler[],
+  execute: (instance: string, command: string, data: unknown) => Promise<unknown>,
+) {
+  const windows = new Map<string, { start: number; count: number }>();
+  const commands = [
+    ['post', 'updateMemberAddMode', 'memberMode'],
+    ['post', 'updateJoinApprovalMode', 'approvalMode'],
+    ['get', 'joinRequests', 'requests'],
+    ['post', 'joinRequests', 'decide'],
+    ['post', 'bcCreate', 'create'],
+    ['post', 'bcSendCode', 'sendCode'],
+    ['post', 'bcSetting', 'setting'],
+    ['post', 'bcMember', 'member'],
+    ['get', 'bcInvite', 'invite'],
+    ['post', 'bcRevoke', 'revoke'],
+    ['get', 'bcCreateStatus', 'createStatus'],
+    ['get', 'bcCapabilities', 'capabilities'],
+    ['get', 'bcInspect', 'inspect'],
+  ] as const;
+  for (const [method, path, command] of commands) {
+    router[method]('/' + path + '/:instanceName', ...guards, async (req, res, next) => {
+      try {
+        const secret = process.env.BC_GROUPS_API_SECRET ?? '',
+          supplied = req.get('x-bc-group-key') ?? '';
+        if (
+          secret.length < 32 ||
+          Buffer.byteLength(secret) !== Buffer.byteLength(supplied) ||
+          !timingSafeEqual(Buffer.from(secret), Buffer.from(supplied))
+        ) {
+          res.status(403).json({ error: 'Acesso restrito ao B&C' });
+          return;
+        }
+
+        const data = method === 'get' ? req.query : req.body;
+        if (!validate(data, bcGroupSchemas[command]).valid) {
+          res.status(400).json({ error: 'Parâmetros inválidos' });
+          return;
+        }
+        const now = Date.now();
+        for (const [name, window] of windows) if (now - window.start >= 60000) windows.delete(name);
+        const window = windows.get(req.params.instanceName) ?? { start: now, count: 0 };
+        if (++window.count > 60) {
+          res.status(429).json({ error: 'Aguarde antes de tentar novamente' });
+          return;
+        }
+        windows.set(req.params.instanceName, window);
+        const result = await execute(req.params.instanceName, command, data);
+        res.status(200).json(result);
+      } catch (error) {
+        next(error);
+      }
+    });
+  }
+  router.use('/:operation/:instanceName', (req, res, next) => {
+    if (extensionEnabled(req.params.instanceName)) {
+      res.status(403).json({ error: 'Instância exclusiva: use o contrato B&C' });
+      return;
+    }
+    next();
+  });
+}
