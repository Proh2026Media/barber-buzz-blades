diff --git a/src/api/integrations/channel/whatsapp/bc-groups/core.ts b/src/api/integrations/channel/whatsapp/bc-groups/core.ts
new file mode 100644
index 00000000..ad77e533
--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/bc-groups/core.ts
@@ -0,0 +1,370 @@
+import { createHash, randomUUID } from 'node:crypto';
+
+import type { GroupMetadata, WASocket } from 'baileys';
+
+export const BC_GROUP_PROTOCOL = 'bc-groups-v2';
+export class GroupExtensionError extends Error {
+  constructor(
+    public status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+const fail = (status: number, message: string): never => {
+  throw new GroupExtensionError(status, message);
+};
+const groupId = (value: unknown): string =>
+  typeof value === 'string' && value.length <= 128 && /^[0-9-]+@g\.us$/.test(value)
+    ? value
+    : fail(400, 'Identificador de grupo inválido');
+const operationId = (value: unknown): string =>
+  typeof value === 'string' && /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(value)
+    ? value.toLowerCase()
+    : fail(400, 'Identificador de operação inválido');
+const pn = (value: unknown): string | null =>
+  typeof value === 'string' && /^[1-9][0-9]{7,14}@s\.whatsapp\.net$/.test(value) ? value : null;
+const identity = (value: unknown): string | null =>
+  typeof value === 'string' && /^[0-9]+(?::[0-9]+)?@(s\.whatsapp\.net|lid)$/.test(value)
+    ? value.replace(/:[0-9]+@/, '@')
+    : null;
+export function extensionEnabled(instanceName: string, env: NodeJS.ProcessEnv = process.env) {
+  return (
+    env.BC_GROUPS_EXTENSION_ENABLED === 'true' &&
+    (env.BC_GROUPS_INSTANCES ?? '')
+      .split(',')
+      .map((s) => s.trim())
+      .includes(instanceName)
+  );
+}
+export function configuredPlatformJids(instanceName: string, env: NodeJS.ProcessEnv = process.env): string[] {
+  try {
+    const values = JSON.parse(env.BC_GROUPS_PLATFORM_JIDS ?? '{}')[instanceName];
+    return Array.isArray(values) && values.length <= 5 && values.every((v) => pn(v))
+      ? ([...new Set(values)] as string[])
+      : [];
+  } catch {
+    return [];
+  }
+}
+export function participantIdentity(value: unknown) {
+  const p =
+    typeof value === 'string' ? { id: value } : (value as { id?: unknown; phoneNumber?: unknown; lid?: unknown });
+  const id = identity(p?.id);
+  const phone = pn(id) ?? pn(p?.phoneNumber);
+  const conflict =
+    Boolean(p?.phoneNumber && (!pn(p.phoneNumber) || (pn(id) && pn(id) !== pn(p.phoneNumber)))) ||
+    Boolean(id?.endsWith('@lid') && p?.lid && id !== p.lid);
+  return {
+    jid: id,
+    conflict,
+    phoneNumber: conflict ? null : phone,
+    lid: typeof p?.lid === 'string' && /^[0-9]+@lid$/.test(p.lid) ? p.lid : id?.endsWith('@lid') ? id : null,
+  };
+}
+export function groupView(group: GroupMetadata) {
+  return {
+    ...group,
+    memberAddMode: typeof group.memberAddMode === 'boolean' ? group.memberAddMode : null,
+    joinApprovalMode: typeof group.joinApprovalMode === 'boolean' ? group.joinApprovalMode : null,
+    addressingMode: group.addressingMode ?? null,
+  };
+}
+export function eventEnvelope(instanceName: string, event: string) {
+  return extensionEnabled(instanceName) && /^(groups\.|group[.-]|message-receipt\.)/.test(event)
+    ? { event_id: randomUUID(), contract_version: BC_GROUP_PROTOCOL }
+    : {};
+}
+export type Operation = {
+  instanceId: string;
+  operationKey: string;
+  requestHash: string;
+  state: string;
+  groupJid: string | null;
+  messageId?: string | null;
+};
+export type OperationStore = {
+  lock: (instanceId: string, token: string) => Promise<boolean>;
+  unlock: (instanceId: string, token: string) => Promise<void>;
+  accepted: (instanceId: string, key: string, messageId: string) => Promise<void>;
+  find: (instanceId: string, key: string) => Promise<Operation | null>;
+  claim: (value: Operation) => Promise<boolean>;
+  created: (instanceId: string, key: string, jid: string) => Promise<void>;
+};
+type Socket = Pick<
+  WASocket,
+  | 'sendMessage'
+  | 'groupSettingUpdate'
+  | 'groupParticipantsUpdate'
+  | 'groupInviteCode'
+  | 'groupRevokeInvite'
+  | 'groupMetadata'
+  | 'groupCreate'
+  | 'groupMemberAddMode'
+  | 'groupJoinApprovalMode'
+  | 'groupRequestParticipantsList'
+  | 'groupRequestParticipantsUpdate'
+>;
+export type Dependencies = {
+  instanceId: string;
+  instanceName: string;
+  socket: Socket;
+  self: () => string[];
+  ready: () => boolean;
+  store: OperationStore;
+  platformJids: string[];
+};
+function strictBody(input: unknown, keys: string[]): Record<string, unknown> {
+  if (!input || typeof input !== 'object' || Array.isArray(input) || Object.keys(input).some((k) => !keys.includes(k)))
+    return fail(400, 'Campos inválidos');
+  return input as Record<string, unknown>;
+}
+async function asAdmin(d: Dependencies, jid: string) {
+  const group = await d.socket.groupMetadata(jid);
+  if (group?.id !== jid) return fail(409, 'Grupo não confirmado');
+  const self = d.self().map(identity).filter(Boolean);
+  const matches = group.participants.filter((p) => {
+    const resolved = participantIdentity(p);
+    return (
+      !resolved.conflict &&
+      (self.includes(resolved.jid) || (resolved.phoneNumber && self.includes(resolved.phoneNumber)))
+    );
+  });
+  if (matches.length !== 1 || !['admin', 'superadmin'].includes(matches[0].admin))
+    return fail(403, 'Número da Plataforma sem administração confirmada');
+  return group;
+}
+async function executeUnlocked(d: Dependencies, command: string, input: unknown) {
+  if (!extensionEnabled(d.instanceName)) return fail(503, 'Extensão de grupos desativada');
+  if (!d.ready() || !d.self().some((jid) => d.platformJids.includes(identity(jid))))
+    return fail(503, 'Número da Plataforma indisponível ou não autorizado');
+  if (command === 'capabilities')
+    return {
+      contract: BC_GROUP_PROTOCOL,
+      memberAddControl: true,
+      admissionControl: true,
+      persistentOperations: true,
+      receiptEvents: true,
+      durableWebhook: false,
+      protectedCodes: true,
+      serializedCommands: true,
+    };
+  if (command === 'createStatus') {
+    const p = strictBody(input, ['operationId']);
+    const key = operationId(p.operationId);
+    return (await d.store.find(d.instanceId, key)) ?? fail(404, 'Operação não encontrada');
+  }
+  if (command === 'create') {
+    const p = strictBody(input, ['operationId', 'subject', 'participants']);
+    const key = operationId(p.operationId);
+    if (typeof p.subject !== 'string' || p.subject.trim().length < 1 || p.subject.length > 100)
+      return fail(400, 'Nome de grupo inválido');
+    if (
+      !Array.isArray(p.participants) ||
+      p.participants.length > 5 ||
+      !p.participants.every((jid) => pn(jid) && d.platformJids.includes(jid)) ||
+      new Set(p.participants).size !== p.participants.length
+    )
+      return fail(400, 'A criação aceita somente números autorizados da Plataforma');
+    const participants = [...p.participants].sort() as string[];
+    const hash = createHash('sha256')
+      .update(JSON.stringify([p.subject, participants]))
+      .digest('hex');
+    const pending: Operation = {
+      instanceId: d.instanceId,
+      operationKey: key,
+      requestHash: hash,
+      state: 'unknown',
+      groupJid: null,
+    };
+    const won = await d.store.claim(pending);
+    if (!won) {
+      const prior = await d.store.find(d.instanceId, key);
+      if (!prior || prior.requestHash !== hash) return fail(409, 'Operação já utilizada com outros parâmetros');
+      return prior;
+    }
+    // Uma queda em qualquer ponto posterior mantém desconhecido. Nunca recuperar a licença para criar.
+    try {
+      if (!d.ready()) return pending;
+      const result = await d.socket.groupCreate(p.subject, participants);
+      const jid = groupId(result?.id);
+      await d.store.created(d.instanceId, key, jid);
+      return { ...pending, state: 'created', groupJid: jid };
+    } catch {
+      return pending;
+    }
+  }
+  if (command === 'sendCode') {
+    const p = strictBody(input, [
+      'operationId',
+      'groupJid',
+      'customerJid',
+      'platformJids',
+      'purpose',
+      'expiresAt',
+      'code',
+    ]);
+    const key = operationId(p.operationId),
+      jid = groupId(p.groupJid);
+    const expiry = typeof p.expiresAt === 'string' ? Date.parse(p.expiresAt) : NaN;
+    if (
+      !pn(p.customerJid) ||
+      !Array.isArray(p.platformJids) ||
+      !p.platformJids.length ||
+      !p.platformJids.every((v) => pn(v) && d.platformJids.includes(v)) ||
+      new Set(p.platformJids).size !== p.platformJids.length ||
+      p.platformJids.includes(p.customerJid) ||
+      !['login', 'verify_phone'].includes(p.purpose as string) ||
+      typeof p.code !== 'string' ||
+      !/^\d{6}$/.test(p.code) ||
+      !Number.isFinite(expiry) ||
+      expiry <= Date.now() ||
+      expiry > Date.now() + 600000
+    )
+      return fail(400, 'Pedido de código inválido');
+    const hash = createHash('sha256')
+      .update(JSON.stringify([jid, p.customerJid, [...p.platformJids].sort(), p.purpose, p.expiresAt]))
+      .digest('hex');
+    const prior = await d.store.find(d.instanceId, key);
+    if (prior) {
+      if (prior.requestHash !== hash) return fail(409, 'Operação incompatível');
+      return prior;
+    }
+    const group = await asAdmin(d, jid);
+    const expected = new Set([p.customerJid, ...p.platformJids]);
+    const seen = new Set<string>();
+    if (group.restrict !== true || group.memberAddMode !== false || group.joinApprovalMode !== true)
+      return fail(409, 'Controles não confirmados');
+    for (const member of group.participants) {
+      const who = participantIdentity(member);
+      if (
+        who.conflict ||
+        !who.phoneNumber ||
+        !expected.has(who.phoneNumber) ||
+        seen.has(who.phoneNumber) ||
+        (member.admin && (!['admin', 'superadmin'].includes(member.admin) || who.phoneNumber === p.customerJid))
+      )
+        return fail(409, 'Composição divergente');
+      seen.add(who.phoneNumber);
+    }
+    if (seen.size !== expected.size || !d.self().some((v) => (p.platformJids as string[]).includes(identity(v))))
+      return fail(409, 'Composição incompleta');
+    const pending: Operation = {
+      instanceId: d.instanceId,
+      operationKey: key,
+      requestHash: hash,
+      state: 'code_unknown',
+      groupJid: jid,
+    };
+    if (!(await d.store.claim(pending))) return (await d.store.find(d.instanceId, key)) ?? pending;
+    try {
+      if (!d.ready() || Date.now() >= expiry) return pending;
+      const text = `Barba & Cabelo\n${p.purpose === 'login' ? 'Seu código de acesso' : 'Código para confirmar seu WhatsApp'}: ${p.code}\nVálido até ${new Date(expiry).toISOString()}. Não compartilhe este código.`;
+      const message = await d.socket.sendMessage(jid, { text });
+      const id = message?.key?.id;
+      if (typeof id !== 'string' || !id || id.length > 200) return pending;
+      await d.store.accepted(d.instanceId, key, id);
+      return { ...pending, state: 'code_accepted', messageId: id };
+    } catch {
+      return pending;
+    }
+  }
+  if (['setting', 'member', 'invite', 'revoke'].includes(command)) {
+    const p = strictBody(input, command === 'member' ? ['groupJid', 'jid', 'action'] : ['groupJid']);
+    const jid = groupId(p.groupJid);
+    await asAdmin(d, jid);
+    if (command === 'setting') {
+      await d.socket.groupSettingUpdate(jid, 'locked');
+      return groupView(await asAdmin(d, jid));
+    }
+    if (command === 'invite')
+      return { inviteUrl: 'https://chat.whatsapp.com/' + (await d.socket.groupInviteCode(jid)) };
+    if (command === 'revoke') {
+      await d.socket.groupRevokeInvite(jid);
+      return { revoked: true };
+    }
+    if (
+      !['add', 'remove'].includes(p.action as string) ||
+      !identity(p.jid) ||
+      (p.action === 'add' && (!pn(p.jid) || !d.platformJids.includes(p.jid as string)))
+    )
+      return fail(400, 'Participante não autorizado');
+    return d.socket.groupParticipantsUpdate(jid, [p.jid as string], p.action as 'add' | 'remove');
+  }
+  const keys =
+    command === 'requests' || command === 'inspect'
+      ? ['groupJid']
+      : command === 'decide'
+        ? ['groupJid', 'participants', 'action']
+        : ['groupJid', 'mode'];
+  const p = strictBody(input, keys);
+  const jid = groupId(p.groupJid);
+  if (!['inspect', 'requests', 'decide', 'memberMode', 'approvalMode'].includes(command))
+    return fail(400, 'Operação inválida');
+  const group = await asAdmin(d, jid);
+  if (command === 'inspect') return groupView(group);
+  if (command === 'requests') return d.socket.groupRequestParticipantsList(jid);
+  if (command === 'decide') {
+    if (
+      !['approve', 'reject'].includes(p.action as string) ||
+      !Array.isArray(p.participants) ||
+      p.participants.length < 1 ||
+      p.participants.length > 50 ||
+      !p.participants.every((v) => typeof v === 'string' && identity(v) === v) ||
+      new Set(p.participants).size !== p.participants.length
+    )
+      return fail(400, 'Pedido de entrada inválido');
+    const pending = await d.socket.groupRequestParticipantsList(jid);
+    if (!p.participants.every((jid) => pending.some((item) => item.jid === jid)))
+      return fail(409, 'Pedido de entrada não está mais pendente');
+    // A decisão de consentimento pertence ao B&C; aqui não há aprovação por mera posse de convite.
+    if (
+      p.action === 'approve' &&
+      (group.memberAddMode !== false || group.joinApprovalMode !== true || group.restrict !== true)
+    )
+      return fail(409, 'Controles de entrada não confirmados');
+    if (!d.ready()) return fail(503, 'Conexão indisponível');
+    return d.socket.groupRequestParticipantsUpdate(jid, p.participants as string[], p.action as 'approve' | 'reject');
+  }
+  if (command === 'memberMode') {
+    if (!['admin_add', 'all_member_add'].includes(p.mode as string)) return fail(400, 'Modo de inclusão inválido');
+    if (!d.ready()) return fail(503, 'Conexão indisponível');
+    await d.socket.groupMemberAddMode(jid, p.mode as 'admin_add' | 'all_member_add');
+  } else {
+    if (!['on', 'off'].includes(p.mode as string)) return fail(400, 'Modo de aprovação inválido');
+    if (!d.ready()) return fail(503, 'Conexão indisponível');
+    await d.socket.groupJoinApprovalMode(jid, p.mode as 'on' | 'off');
+  }
+  const observed = await asAdmin(d, jid);
+  const verified =
+    command === 'memberMode'
+      ? observed.memberAddMode === (p.mode === 'all_member_add')
+      : observed.joinApprovalMode === (p.mode === 'on');
+  if (!verified) return fail(409, 'Alteração sem confirmação; conferir antes de continuar');
+  return groupView(observed);
+}
+
+/** A trava persistente não expira sozinha: processo perdido exige revisão antes de liberar. */
+export async function executeGroupCommand(d: Dependencies, command: string, input: unknown) {
+  if (['capabilities', 'createStatus'].includes(command)) return executeUnlocked(d, command, input);
+  const token = randomUUID();
+  if (!(await d.store.lock(d.instanceId, token))) return fail(409, 'Operação em andamento; conferir antes de repetir');
+  try {
+    return await executeUnlocked(d, command, input);
+  } finally {
+    await d.store.unlock(d.instanceId, token);
+  }
+}
+
+/** Não armazenar nem reenviar OTP para webhooks, chats ou integrações secundárias. */
+export function isGroupCodeMessage(message: { key?: { remoteJid?: string }; message?: unknown }) {
+  if (!/@g\.us$/.test(message?.key?.remoteJid ?? '')) return false;
+  let remaining = 1000;
+  const contains = (value: unknown, depth = 0): boolean => {
+    if (--remaining < 0 || depth > 10) return false;
+    if (typeof value === 'string')
+      return /Barba & Cabelo\n(?:Seu código de acesso|Código para confirmar seu WhatsApp): \d{6}\n/.test(value);
+    return Boolean(value && typeof value === 'object' && Object.values(value).some((v) => contains(v, depth + 1)));
+  };
+  return contains(message.message);
+}
