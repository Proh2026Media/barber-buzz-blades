+ const b=new PrismaClient();try {const record=await operationStore(b).find('otp',key);assert.equal(record?.state,'code_accepted');assert.equal(record?.messageId,'mensagem-ficticia');assert.ok(!('code' in record!));}finally{await b.$disconnect();}
