+import test from 'node:test';
+process.env.BC_GROUPS_API_SECRET='s'.repeat(40);
+import assert from 'node:assert/strict';
+import express from 'express';
+import { registerBcGroupRoutes } from '../src/api/routes/bc-group.routes';
+import { bcGroupSchemas } from '../src/api/routes/bc-group.schemas';
+import { validate } from 'jsonschema';
+import { once } from 'node:events';
+test('Treze rotas preservam guardas, validação e instância autenticada', async () => {
+  const app = express();
+  app.use(express.json());
+  const router = express.Router();
+  let guards = 0;
+  const calls: any[] = [];
+  registerBcGroupRoutes(
+    router,
+    [
+      (req, res, next) => {
+        guards++;
+        if (req.get('apikey') !== 'ficticia') {
+          res.sendStatus(401);
+          return;
+        }
+        next();
+      },
+    ],
+    async (instance, command, data) => {
+      calls.push({ instance, command, data });
+      return { ok: true };
+    },
+  );
+  app.use('/group', router);
+  const server = app.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const port = (server.address() as any).port;
+  const groupJid = '12345@g.us',
+    operationId = '11111111-1111-4111-8111-111111111111';
+  const routes: [string, string, Record<string, unknown>][] = [
+    ['POST', 'updateMemberAddMode', { groupJid, mode: 'admin_add' }],
+    ['POST', 'updateJoinApprovalMode', { groupJid, mode: 'on' }],
+    ['GET', 'joinRequests', { groupJid }],
+    ['POST', 'joinRequests', { groupJid, participants: ['5511888888888@s.whatsapp.net'], action: 'reject' }],
+    ['POST', 'bcCreate', { operationId, subject: 'Teste', participants: [] }],
+    ['GET', 'bcCreateStatus', { operationId }],
+    ['GET', 'bcCapabilities', {}],
+    ['GET', 'bcInspect', { groupJid }],
+    ['POST','bcSendCode',{operationId,groupJid,customerJid:'5511999999999@s.whatsapp.net',platformJids:['5511888888888@s.whatsapp.net'],purpose:'login',expiresAt:new Date(Date.now()+60000).toISOString(),code:'123456'}],
+    ['POST','bcSetting',{groupJid}],
+    ['POST','bcMember',{groupJid,jid:'5511888888888@s.whatsapp.net',action:'add'}],
+    ['GET','bcInvite',{groupJid}],
+    ['POST','bcRevoke',{groupJid}],
+  ];
+  try {
+    for (const [method, path, body] of routes) {
+      let url = `http://127.0.0.1:${port}/group/${path}/correta`;
+      const options: any = { method, headers: { 'content-type': 'application/json', apikey: 'ficticia', 'x-bc-group-key':'s'.repeat(40) } };
+      if (method === 'GET') url += '?' + new URLSearchParams(body as Record<string, string>);
+      else options.body = JSON.stringify(body);
+      assert.equal((await fetch(url, { ...options, headers: {} })).status, 401);
+      assert.equal((await fetch(url,{...options,headers:{...options.headers,'x-bc-group-key':'incorreta'}})).status,403);
+      assert.equal((await fetch(url, options)).status, 200);
+      const attack = method === 'GET' ? url + (url.includes('?') ? '&' : '?') + 'instanceName=outra' : url;
+      assert.equal(
+        (
+          await fetch(
+            attack,
+            method === 'POST' ? { ...options, body: JSON.stringify({ ...body, instanceName: 'outra' }) } : options,
+          )
+        ).status,
+        400,
+      );
+    }
+    assert.equal(guards, 52);
+    assert.equal(calls.length, 13);
+    assert.ok(calls.every((c) => c.instance === 'correta'));
+    for (let i = 0; i < 47; i++)
+      assert.equal(
+        (await fetch(`http://127.0.0.1:${port}/group/bcCapabilities/correta`, { headers: { apikey: 'ficticia', 'x-bc-group-key':'s'.repeat(40) } }))
+          .status,
+        200,
+      );
+    assert.equal(
+      (await fetch(`http://127.0.0.1:${port}/group/bcCapabilities/correta`, { headers: { apikey: 'ficticia', 'x-bc-group-key':'s'.repeat(40) } }))
+        .status,
+      429,
+    );
+  } finally {
+    await new Promise<void>((resolve, reject) => server.close((e) => (e ? reject(e) : resolve())));
+  }
+});
+test('Schemas rejeitam JID solto, promoção e modo não suportado', () => {
+  assert.equal(validate({ groupJid: '12345' }, bcGroupSchemas.inspect).valid, false);
+  assert.equal(validate({ groupJid: '12345@g.us', mode: 'inventado' }, bcGroupSchemas.memberMode).valid, false);
+  assert.equal(
+    validate(
+      { groupJid: '12345@g.us', participants: ['5511888888888@s.whatsapp.net'], action: 'promote' },
+      bcGroupSchemas.decide,
+    ).valid,
+    false,
+  );
+});
