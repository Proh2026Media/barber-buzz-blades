+test('Envelope só é acrescentado às instâncias e eventos autorizados', () => {
+  assert.deepEqual(eventEnvelope('outra', 'groups.update'), {});
+  assert.deepEqual(eventEnvelope(shop, 'messages.upsert'), {});
+  const e = eventEnvelope(shop, 'group-participants.update');
