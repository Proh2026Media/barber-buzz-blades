+  assert.equal(((await executeGroupCommand(f.d, 'create', request)) as Operation).state, 'unknown');
+  await executeGroupCommand(f.d, 'create', request);
+  assert.equal(f.creates, 1);
+});
+test('Banco indisponível antes da licença impede chamada externa', async () => {
+  const f = fixture();
+  f.d.store.claim = async () => {
+    throw new Error('banco');
+  };
+  await assert.rejects(() => executeGroupCommand(f.d, 'create', request));
+  assert.equal(f.creates, 0);
+});
+test('Consulta de outra instância não revela operação', async () => {
+  const f = fixture();
+  await executeGroupCommand(f.d, 'create', request);
+  f.d.instanceId = 'outro-id';
+  await rejects(() => executeGroupCommand(f.d, 'createStatus', { operationId }), 404);
+});
+test('Somente admin real aplica controles; enum inválido não modifica', async () => {
+  const f = fixture();
+  f.metadata.participants[0].admin = null;
+  await rejects(() => executeGroupCommand(f.d, 'memberMode', { groupJid: jid, mode: 'admin_add' }), 403);
+  f.metadata.participants[0].admin = 'admin';
+  await rejects(() => executeGroupCommand(f.d, 'memberMode', { groupJid: jid, mode: 'inventado' }), 400);
+});
+test('Controles retornam leitura atual, não presumem sucesso', async () => {
+  const f = fixture();
+  f.metadata.memberAddMode = true;
+  assert.equal(
+    ((await executeGroupCommand(f.d, 'memberMode', { groupJid: jid, mode: 'admin_add' })) as any).memberAddMode,
