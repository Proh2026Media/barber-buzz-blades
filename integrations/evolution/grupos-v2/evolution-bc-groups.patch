+test('Mesmo identificador com conteúdo diferente é conflito', async () => {
+  const f = fixture();
+  await executeGroupCommand(f.d, 'create', request);
+  await rejects(() => executeGroupCommand(f.d, 'create', { ...request, subject: 'Outro' }), 409);
+  assert.equal(f.creates, 1);
