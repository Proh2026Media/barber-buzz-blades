+import test from 'node:test';
+import assert from 'node:assert/strict';
+import axios from 'axios';
+import { WebhookController } from '../src/api/integrations/event/webhook/webhook.controller';
+import { configService } from '../src/config/env.config';
+process.env.BC_GROUPS_EXTENSION_ENABLED = 'true';
+process.env.BC_GROUPS_INSTANCES = 'bc-ficticia';
+test('Webhook local preserva ID no retry, usa header e omite apikey de grupos B&C', async () => {
+  const originalGet = configService.get,
+    originalCreate = axios.create;
+  const bodies: any[] = [];
+  let headers: any;
+  configService.get = ((key: string) =>
+    key === 'LOG'
+      ? { LEVEL: [] }
+      : {
+          GLOBAL: { ENABLED: false },
+          REQUEST: { TIMEOUT_MS: 1000 },
+          RETRY: { MAX_ATTEMPTS: 2, INITIAL_DELAY_SECONDS: 0 },
+        }) as typeof configService.get;
+  axios.create = ((options: any) => {
+    headers = options.headers;
+    return {
+      post: async (_path: string, body: any) => {
+        bodies.push(structuredClone(body));
+        if (bodies.length === 1) throw { response: { status: 503 } };
+      },
+    };
+  }) as typeof axios.create;
+  try {
+    const db: any = {
+      webhook: {
+        findUnique: async () => ({
+          enabled: true,
+          url: 'https://example.invalid/webhook',
+          events: ['GROUP_PARTICIPANTS_UPDATE'],
+          headers: { 'x-bc-group-secret': 'ficticio' },
+        }),
+      },
+    };
+    const monitor: any = { waInstances: { 'bc-ficticia': { instanceId: 'instancia-ficticia' } } };
+    const controller = new WebhookController(db, monitor);
+    await controller.emit({
+      instanceName: 'bc-ficticia',
+      origin: 'teste',
+      event: 'group-participants.update',
+      data: { id: '12345@g.us', participants: [] },
+      serverUrl: 'https://example.invalid',
+      dateTime: '2026-11-11T00:00:00Z',
+      sender: 'ficticio',
+      apiKey: 'NAO-ENVIAR',
+      extra: { apikey: 'NAO-ENVIAR-EXTRA' },
+      local: true,
+    });
+    assert.equal(bodies.length, 2);
+    assert.equal(bodies[0].event_id, bodies[1].event_id);
+    assert.equal(bodies[0].contract_version, 'bc-groups-v2');
+    assert.equal(headers['x-bc-group-secret'], 'ficticio');
+    assert.equal(bodies[0].apikey, undefined);
+  } finally {
+    configService.get = originalGet;
+    axios.create = originalCreate;
+  }
+});
+test('Recibo encaminhado conserva identidade individual, sem inventar entrega ao Cliente', async () => {
+  const originalGet = configService.get,
+    originalCreate = axios.create;
+  let body: any;
+  configService.get = ((key: string) =>
+    key === 'LOG'
+      ? { LEVEL: [] }
+      : { GLOBAL: { ENABLED: false }, RETRY: { MAX_ATTEMPTS: 1 } }) as typeof configService.get;
+  axios.create = (() => ({
+    post: async (_path: string, value: any) => {
+      body = value;
+    },
+  })) as typeof axios.create;
+  try {
+    const controller = new WebhookController(
+      {
+        webhook: {
+          findUnique: async () => ({
+            enabled: true,
+            url: 'https://example.invalid/webhook',
+            events: ['MESSAGE_RECEIPT_UPDATE'],
+            headers: { 'x-bc-group-secret': 'ficticio' },
+          }),
+        },
+      } as any,
+      { waInstances: { 'bc-ficticia': { instanceId: 'instancia-ficticia' } } } as any,
+    );
+    const receipt = {
+      key: { id: 'mensagem-ficticia', remoteJid: '12345@g.us' },
+      receipt: { userJid: '5511777777777@s.whatsapp.net', readTimestamp: 123 },
+    };
+    await controller.emit({
+      instanceName: 'bc-ficticia',
+      origin: 'teste',
+      event: 'message-receipt.update',
+      data: [receipt],
+      serverUrl: 'https://example.invalid',
+      dateTime: '2026-11-11T00:00:00Z',
+      sender: 'ficticio',
+      local: true,
+    });
+    assert.deepEqual(body.data, [receipt]);
+    assert.equal(body.data[0].deliveredToCustomer, undefined);
+  } finally {
+    configService.get = originalGet;
+    axios.create = originalCreate;
+  }
+});
