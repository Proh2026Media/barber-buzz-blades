+  assert.equal(groupView({ id: jid, participants: [] } as any).joinApprovalMode, null);
+});
+test('Grupo diferente e PN conflitante não conferem administração', async () => {
+  const f = fixture();
+  f.metadata.id = '999@g.us';
+  await rejects(() => executeGroupCommand(f.d, 'inspect', { groupJid: jid }), 409);
+});
+test('Terceiro sem pedido pendente não é aprovado', async () => {
+  const f = fixture();
+  await rejects(
+    () => executeGroupCommand(f.d, 'decide', { groupJid: jid, participants: [self], action: 'approve' }),
