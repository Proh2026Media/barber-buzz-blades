+++ b/test/bc-group-database.test.ts
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PrismaClient } from '@prisma/client';
+import { operationStore } from '../src/api/integrations/channel/whatsapp/bc-groups/store';
+import {
+  executeGroupCommand,
+  type Dependencies,
+  type Operation,
+} from '../src/api/integrations/channel/whatsapp/bc-groups/core';
+const url = new URL(process.env.DATABASE_CONNECTION_URI ?? 'http://invalido');
+if (
+  process.env.BC_GROUP_TEST_DATABASE !== 'local-only' ||
+  url.hostname !== '127.0.0.1' ||
+  url.port !== '54332' ||
+  url.pathname !== '/postgres'
+)
+  throw new Error('Este teste exige banco local descartável na porta 54332');
+process.env.BC_GROUPS_EXTENSION_ENABLED = 'true';
+process.env.BC_GROUPS_INSTANCES = 'bc-ficticia';
+const self = '5511888888888@s.whatsapp.net',
+  jid = '12345-67890@g.us';
+let creates = 0;
+function deps(db: PrismaClient): Dependencies {
+  return {
+    instanceId: 'teste',
+    instanceName: 'bc-ficticia',
+    platformJids: [self],
+    ready: () => true,
+    self: () => [self],
+    store: operationStore(db),
+    socket: {
+      groupCreate: async () => {
+        creates++;
+        await new Promise((r) => setTimeout(r, 30));
+        return { id: jid };
+      },
+    } as unknown as Dependencies,
+  };
+}
+test('PostgreSQL: dois clientes disputam uma criação, inclusive depois de reiniciar clientes', async () => {
+  const a = new PrismaClient(),
+    b = new PrismaClient();
+  const request = { operationId: '11111111-1111-4111-8111-111111111111', subject: 'Fictício', participants: [] };
+  try {
+    await Promise.allSettled([
+      executeGroupCommand(deps(a), 'create', request),
+      executeGroupCommand(deps(b), 'create', request),
+    ]);
+    assert.equal(creates, 1);
+    assert.equal(await a.bcGroupOperation.count(), 1);
+  } finally {
+    await a.$disconnect();
+    await b.$disconnect();
+  }
+  const next = new PrismaClient();
+  try {
+    assert.equal(((await executeGroupCommand(deps(next), 'create', request)) as Operation).groupJid, jid);
+    assert.equal(creates, 1);
+    assert.equal(await operationStore(next).find('outra', request.operationId), null);
+  } finally {
+    await next.$disconnect();
+  }
+});
+test('PostgreSQL: queda depois da criação mantém desconhecido, sem segunda chamada', async () => {
