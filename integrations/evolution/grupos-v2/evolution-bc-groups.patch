+# Extensão local sobre a imagem exata relatada pela TI. Nenhuma tag mutável.
+FROM evoapicloud/evolution-api@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339 AS builder
+WORKDIR /evolution
+ARG DATABASE_PROVIDER=postgresql
+COPY package.json package-lock.json tsconfig.json tsup.config.ts ./
+COPY src ./src
+COPY prisma ./prisma
+RUN case "$DATABASE_PROVIDER" in postgresql|mysql) ;; *) exit 1 ;; esac && \
+    DATABASE_CONNECTION_URI="$DATABASE_PROVIDER://build:build@127.0.0.1:1/build" \
+    npx --no-install prisma generate --schema "prisma/$DATABASE_PROVIDER-schema.prisma" && \
+    npm run build
+
+FROM evoapicloud/evolution-api@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
+WORKDIR /evolution
+ARG BC_PATCH_SHA256=nao-informado
+LABEL org.opencontainers.image.version="2.3.7-bc.groups.2" \
+      org.bc.base-revision="cd800f2976e1e5b682fbf86a01ee4d85ae61f370" \
+      org.bc.patch-sha256="$BC_PATCH_SHA256"
+COPY --from=builder /evolution/dist ./dist
+COPY --from=builder /evolution/node_modules/.prisma ./node_modules/.prisma
+COPY --from=builder /evolution/prisma ./prisma
+COPY --from=builder /evolution/package.json ./package.json
+COPY --from=builder /evolution/package-lock.json ./package-lock.json
+ENV BC_GROUPS_EXTENSION_ENABLED=false
+# Migrations exigem etapa própria autorizada; não imprimir URL de banco nem migrar ao reiniciar.
+ENTRYPOINT ["node", "dist/main.js"]
