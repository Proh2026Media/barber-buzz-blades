 // getPasskeyWebAuthn creates a *webauthn.WebAuthn instance from the shared server-side WebAuthn configuration.
+type dominioDaLoja struct {
+	Host string
+	Nome string `db:"nome"`
+	Loja string `db:"loja"`
+}
+
+func lojaDaOrigem(db *storage.Connection, origem string) (dominioDaLoja, error) {
+	var loja dominioDaLoja
+	u, err := url.Parse(origem)
+	if err != nil || u.Scheme != "https" || u.User != nil || u.Hostname() == "" || origem != "https://"+u.Hostname() || strings.HasSuffix(u.Hostname(), ".") {
+		return loja, nil
+	}
+	err = db.RawQuery("select coalesce(case when r->>'canonical_host' = ? then r->>'shop_name' end,'') as nome, coalesce(case when r->>'canonical_host' = ? then r->>'shop_id' end,'') as loja from (select public.resolve_shop_by_host(?) as r) s", u.Hostname(), u.Hostname(), u.Hostname()).First(&loja)
+	if err != nil {
+		return loja, err
+	}
+	loja.Host = u.Hostname()
+	return loja, nil
+}
+
+func (a *API) chaveDaLoja(r *http.Request) (*webauthn.WebAuthn, dominioDaLoja, error) {
+	loja, err := lojaDaOrigem(a.db.WithContext(r.Context()), r.Header.Get("Origin"))
+	if err != nil || loja.Loja == "" || loja.Nome == "" {
+		return nil, loja, apierrors.NewForbiddenError(apierrors.ErrorCodeValidationFailed, "Origem de estabelecimento indisponível")
+	}
+	wn, err := webauthn.New(&webauthn.Config{
+		RPID: loja.Host, RPDisplayName: loja.Nome, RPOrigins: []string{"https://" + loja.Host},
+		AttestationPreference:  protocol.PreferNoAttestation,
+		AuthenticatorSelection: protocol.AuthenticatorSelection{ResidentKey: protocol.ResidentKeyRequirementRequired, UserVerification: protocol.VerificationRequired},
+	})
+	return wn, loja, err
+}
+
+// Configuração original utilizada pelos ensaios unitários do upstream.
 func (a *API) getPasskeyWebAuthn() (*webauthn.WebAuthn, error) {
 	rpConfig := a.config.WebAuthn
 
