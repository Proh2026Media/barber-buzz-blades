[Unit]
Description=Leitura da planilha da Externa Barbearia
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/aurset/externa-espelho
ExecStart=/usr/bin/python3 -B /opt/aurset/externa-espelho/espelho.py
Environment=PYTHONUTF8=1
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
