# Install as /etc/cron.d/barba-slot-waiting (root:root, 0644).
# The DB function is idempotent. API reads and writes also enforce deadlines.
* * * * * root /usr/bin/docker exec supabase-db-z2dbb7dkyzhc8vjiywq34mhn psql -U postgres -d postgres -v ON_ERROR_STOP=1 -c 'select public.process_slot_waits();' >/dev/null 2>&1 || /usr/bin/logger -t barba-slot-waiting 'Falha ao processar vencimentos da espera'
