+test('Trava por grupo impede mutação concorrente por outra conta',async()=>{const f=await prepared();let release:()=>void;const waiting=new Promise<void>(r=>release=r);f.d.socket.sendMessage=async()=>{await waiting;return {key:{id:'x'}} as any;};const running=executeGroupCommand(f.d,'sendCode',code());await new Promise(r=>setTimeout(r,5));const alternate={...f.d,instanceId:'criador',self:()=>[a]};await rejects(()=>executeGroupCommand(alternate,'subject',{groupJid:id,subject:'Outro',customerJid:u,platformJids:[a,b],allowAbsent:false}),409);release!();await running;});
+test('OTP próprio ou citado não entra em histórico/webhook, com qualquer barbearia',()=>{for(const shop of ['Arena','Barba & Cabelo'])assert.equal(isGroupCodeMessage({key:{remoteJid:id},message:{extendedTextMessage:{text:'resposta',contextInfo:{quotedMessage:{conversation:shop+'\nSeu código de acesso: 123456\nVálido'}}}}}),true);assert.equal(isGroupCodeMessage({key:{remoteJid:id},message:{conversation:'Mensagem comum'}}),false);});
+test('Título mantém JID, restaura renomeação e não escreve quando já está correto',async()=>{const f=await prepared();let writes=0;f.d.socket.groupUpdateSubject=async(_id,subject)=>{writes++;f.raw.subject=subject;};const r={groupJid:id,subject:'Seg. 11/01 às 14h00 • Notificações Arena • Cliente',customerJid:u,platformJids:[a,b],allowAbsent:false};await executeGroupCommand(f.d,'subject',r);await executeGroupCommand(f.d,'subject',r);assert.equal(writes,1);f.raw.subject='Manual';await executeGroupCommand(f.d,'subject',r);assert.equal(writes,2);assert.equal(f.creates(),1);});
+test('Título não confirmado não acusa sucesso',async()=>{const f=await prepared();f.d.socket.groupUpdateSubject=async()=>{};await rejects(()=>executeGroupCommand(f.d,'subject',{groupJid:id,subject:'Outro',customerJid:u,platformJids:[a,b],allowAbsent:false}),409);});
+test('Nova fixação exige ID das boas-vindas duráveis; não aceita código ou ID arbitrário',async()=>{const f=await prepared();const count=f.sent.length;await rejects(()=>executeGroupCommand(f.d,'pinNotice',{groupJid:id,operationId:key(9),messageId:'inventado',duration:2592000}),409);assert.equal(f.sent.length,count);});
