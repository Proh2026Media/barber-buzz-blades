+    if (op.prior) return op.prior;
+    try {
+      await d.socket.chatModify({ delete: true, lastMessages: [range] }, id);
+      await complete(d, op, key, 'delete_accepted');
+      c.closeProof.deleted[who] = true;
+      await d.cycles.saveCycle(c);
+      if (c.platformJids.every((pn) => c.closeProof.deleted[pn])) await d.cycles.minimizeClosed(c);
+      return { ...op.pending, state: 'delete_accepted' };
+    } catch {
+      return op.pending;
+    }
+  }
+  const last = c.closeProof.lastJid;
+  if (p.stage === 'withdraw') {
+    if (who !== last || p.targetJid === last || !c.platformJids.includes(p.targetJid as string))
+      return fail(403, 'Retirada de conta não autorizada');
+    const target = p.targetJid as string;
+    let raw = await metadata(d, id);
+    if (raw.participants.some((p) => !memberPhone(p) || !c.platformJids.includes(memberPhone(p))))
+      return fail(409, 'Cliente/terceiro ainda presente');
+    const member = raw.participants.find((p) => memberPhone(p) === target);
+    if (!member) {
+      if (!c.leftInstances.includes(target)) c.leftInstances.push(target);
+      await d.cycles.saveCycle(c);
+      return { state: 'left' };
+    }
+    const op = await operation(d, c, key, ['withdraw', who, target], 'leave_unknown');
+    if (op.prior) return op.prior;
+    try {
+      await d.socket.groupParticipantsUpdate(id, [member.id], 'remove');
+      raw = await metadata(d, id);
+      if (raw.participants.some((p) => memberPhone(p) === target)) return op.pending;
+      c.leftInstances.push(target);
+      await d.cycles.saveCycle(c);
+      await complete(d, op, key, 'leave_accepted');
+      return { ...op.pending, state: 'left' };
+    } catch {
+      return op.pending;
+    }
+  }
+
+  if ((p.stage === 'final') !== (who === last)) return fail(409, 'Ordem de saída protege o último administrador');
+  if (p.stage === 'final' && c.platformJids.some((p) => p !== who && !c.leftInstances.includes(p)))
+    return fail(409, 'Outra conta ainda não confirmou a saída');
+  // A consulta autoritativa também recupera uma saída aceita cujo retorno se perdeu.
+  const participating = await d.socket.groupFetchAllParticipating();
+  if (!participating || typeof participating !== 'object') return fail(409, 'Participação não comprovada');
+  if (!participating[id]) {
+    if (!c.leftInstances.includes(who)) c.leftInstances.push(who);
+    if (p.stage === 'final') {
+      c.closed = true;
+      delete c.brand;
+    }
+    await d.cycles.saveCycle(c);
+    return { state: c.closed ? 'closed' : 'left' };
+  }
+  const raw = await metadata(d, id);
+  if (
+    raw.participants.some((p) => {
+      const phone = memberPhone(p);
+      return !phone || !c.platformJids.includes(phone);
+    })
+  )
+    return fail(409, 'Não sair enquanto houver cliente ou identidade desconhecida');
+  if (p.stage === 'final' && raw.participants.some((p) => memberPhone(p) !== who))
+    return fail(409, 'Última saída exige somente o administrador final');
+  if (
+    p.stage === 'leave' &&
+    !raw.participants.some((p) => memberPhone(p) === last && ['admin', 'superadmin'].includes(p.admin))
+  )
+    return fail(409, 'Administrador final não comprovado');
+  const priorKey = c.closeProof.leaveOps[who];
+  if (priorKey && priorKey !== key) return fail(409, 'Saída anterior incerta; consultar a mesma operação');
+  const op = await operation(d, c, key, ['leave', who, p.stage], 'leave_unknown');
+  if (op.prior) return op.prior;
+  c.closeProof.leaveOps[who] = key;
+  await d.cycles.saveCycle(c);
+  try {
+    await d.socket.groupLeave(id);
+    const observed = await d.socket.groupFetchAllParticipating();
+    if (!observed || observed[id]) return op.pending;
+    await complete(d, op, key, 'leave_accepted');
+    c.leftInstances.push(who);
+    if (p.stage === 'final') {
+      c.closed = true;
+      delete c.brand;
+    }
+    await d.cycles.saveCycle(c);
+    return { ...op.pending, state: c.closed ? 'closed' : 'left' };
+  } catch {
+    return op.pending;
+  }
+}
diff --git a/src/api/integrations/channel/whatsapp/bc-groups/cycle-evidence.ts b/src/api/integrations/channel/whatsapp/bc-groups/cycle-evidence.ts
