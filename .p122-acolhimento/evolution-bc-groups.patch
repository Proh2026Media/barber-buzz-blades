@@ -0,0 +1,54 @@
+import type { PrismaClient } from '@prisma/client';
+
+import { phoneJid } from './cycle';
+/** Registro técnico separado de clientes. Sem token, QR ou senha no diário. */
+export async function authorizePlatformAccount(
+  db: PrismaClient,
+  instanceId: string,
+  instanceName: string,
+  live: unknown[],
+  ready: boolean,
+  input: unknown,
+) {
+  const p = input as { ownerJid?: unknown; enabled?: unknown; sourceVersion?: unknown };
+  if (
+    !p ||
+    typeof p !== 'object' ||
+    Object.keys(p).some((k) => !['ownerJid', 'enabled', 'sourceVersion'].includes(k)) ||
+    (p.enabled === true && phoneJid(p.ownerJid) !== p.ownerJid) ||
+    typeof p.enabled !== 'boolean' ||
+    !Number.isSafeInteger(p.sourceVersion) ||
+    Number(p.sourceVersion) < 0
+  )
+    throw new Error('Registro de número inválido');
+  if (p.enabled && (!ready || !live.map(phoneJid).includes(p.ownerJid as string)))
+    throw new Error('Telefone da instância não comprovado');
+  const version = BigInt(Number(p.sourceVersion));
+  const old = await db.bcPlatformAccount.findFirst({ where: { OR: [{ instanceId }, { instanceName }] } });
+  if (old && old.sourceVersion > version) throw new Error('Registro desatualizado');
+  if (old && old.sourceVersion === version && (p.enabled !== old.enabled || (p.enabled && old.ownerJid !== p.ownerJid)))
+    throw new Error('Identidade ou autorização alterada sem revisão');
+  if (!old && !p.enabled) return { enabled: false };
+  if (old) {
+    const updated = await db.bcPlatformAccount.updateMany({
+      where: {
+        instanceId: old.instanceId,
+        sourceVersion: old.sourceVersion,
+        ownerJid: old.ownerJid,
+        enabled: old.enabled,
+      },
+      data: {
+        instanceId,
+        instanceName,
+        enabled: p.enabled,
+        sourceVersion: version,
+        ...(p.enabled ? { ownerJid: p.ownerJid as string } : {}),
+      },
+    });
+    if (updated.count !== 1) throw new Error('Registro desatualizado');
+  } else
+    await db.bcPlatformAccount.create({
+      data: { instanceId, instanceName, ownerJid: p.ownerJid as string, enabled: p.enabled, sourceVersion: version },
+    });
+  return { enabled: p.enabled, sourceVersion: Number(version) };
+}
diff --git a/src/api/integrations/channel/whatsapp/bc-groups/store.ts b/src/api/integrations/channel/whatsapp/bc-groups/store.ts
