+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {executeGroupCommand,isGroupCodeMessage,participantIdentity,groupView,extensionEnabled,configuredPlatformJids,eventEnvelope} from '../src/api/integrations/channel/whatsapp/bc-groups/core';
