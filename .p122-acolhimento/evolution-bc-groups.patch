+if (
+  process.env.BC_GROUP_TEST_DATABASE !== 'local-only' ||
+  url.hostname !== '127.0.0.1' ||
+  !['54332','54340'].includes(url.port) ||
+  url.pathname !== '/postgres'
+)
+  throw new Error('Este teste exige banco local descartável na porta 54332');
+process.env.BC_GROUPS_EXTENSION_ENABLED = 'true';
+process.env.BC_GROUPS_INSTANCES = 'bc-ficticia';
+const self = '5511888888888@s.whatsapp.net',
+  jid = '12345-67890@g.us';
+let creates = 0;
+function deps(db: PrismaClient): Dependencies {
+  return {
+    instanceId: 'teste',
+    instanceName: 'bc-ficticia',
+    platformJids: [self,'5511777777777@s.whatsapp.net'],peersReady:()=>true,cycles:cycleStore(db),
+    ready: () => true,
+    self: () => [self],
+    store: operationStore(db),
+    socket: {
+      groupCreate: async () => {
+        creates++;
+        await new Promise((r) => setTimeout(r, 30));
+        return { id: jid };
+      },
+    } as unknown as Dependencies,
+  };
+}
+test('PostgreSQL: dois clientes disputam uma criação, inclusive depois de reiniciar clientes', async () => {
+  const a = new PrismaClient(),
+    b = new PrismaClient();
+  const request = { operationId: '11111111-1111-4111-8111-111111111111', cycleId:'cccccccc-cccc-4ccc-8ccc-cccccccccccc',subject: 'Fictício', participants: ['5511777777777@s.whatsapp.net'],customerJid:'5511999999999@s.whatsapp.net',brand:{shop_name:'Fictícia',customer_name:'Cliente',slug:'ficticia',timezone:'America/Sao_Paulo'} };
+  try {
+    await Promise.allSettled([
+      executeGroupCommand(deps(a), 'create', request),
+      executeGroupCommand(deps(b), 'create', request),
+    ]);
+    assert.equal(creates, 1);
+    assert.equal(await a.bcGroupOperation.count({where:{instanceId:'teste'}}), 1);
+  } finally {
+    await a.$disconnect();
+    await b.$disconnect();
+  }
+  const next = new PrismaClient();
+  try {
+    assert.equal(((await executeGroupCommand(deps(next), 'create', request)) as Operation).groupJid, jid);
+    assert.equal(creates, 1);
+    assert.equal(await operationStore(next).find('outra', request.operationId), null);
+  } finally {
+    await next.$disconnect();
+  }
+});
+test('PostgreSQL: queda depois da criação mantém desconhecido, sem segunda chamada', async () => {
+  const request = { operationId: '22222222-2222-4222-8222-222222222222', cycleId:'dddddddd-dddd-4ddd-8ddd-dddddddddddd',subject: 'Fictício', participants: ['5511777777777@s.whatsapp.net'],customerJid:'5511999999999@s.whatsapp.net',brand:{shop_name:'Fictícia',customer_name:'Cliente',slug:'ficticia',timezone:'America/Sao_Paulo'} };
+  const a = new PrismaClient();
+  let before = creates;
+  try {
+    const d = deps(a);
+    d.store.created = async () => {
+      throw new Error('Falha fictícia na confirmação');
+    };
+    assert.equal(((await executeGroupCommand(d, 'create', request)) as Operation).state, 'unknown');
+  } finally {
+    await a.$disconnect();
+  }
+  const b = new PrismaClient();
+  try {
+    assert.equal(((await executeGroupCommand(deps(b), 'create', request)) as Operation).state, 'unknown');
+    assert.equal(creates, before + 1);
+    assert.equal(await b.bcGroupOperation.count({where:{instanceId:'teste'}}), 2);
+  } finally {
+    await b.$disconnect();
+  }
+});
+
+test('PostgreSQL: trava sobrevive a desconexão e só o titular a solta',async()=>{
+ const a=new PrismaClient();await operationStore(a).lock('travada','titular');await a.$disconnect();
+ const b=new PrismaClient();try {const store=operationStore(b);assert.equal(await store.lock('travada','outro'),false);await store.unlock('travada','outro');assert.equal(await store.lock('travada','novo'),false);await store.unlock('travada','titular');assert.equal(await store.lock('travada','novo'),true);await store.unlock('travada','novo');}finally{await b.$disconnect();}
+});
+test('PostgreSQL: confirmação de código persiste sem texto nem código',async()=>{
+ const a=new PrismaClient();const key='33333333-3333-4333-8333-333333333333';
+ try{const store=operationStore(a);await store.claim({instanceId:'otp',operationKey:key,requestHash:'a'.repeat(64),state:'code_unknown',groupJid:jid});await store.accepted('otp',key,'mensagem-ficticia');}finally{await a.$disconnect();}
+ const b=new PrismaClient();try {const record=await operationStore(b).find('otp',key);assert.equal(record?.state,'code_accepted');assert.equal(record?.messageId,'mensagem-ficticia');assert.ok(!('code' in record!));}finally{await b.$disconnect();}
+});
+
+test('PostgreSQL: confirmação do pin persiste sem texto ou código',async()=>{const key='44444444-4444-4444-8444-444444444444';const a=new PrismaClient();try {const store=operationStore(a);await store.claim({instanceId:'pin',operationKey:key,requestHash:'b'.repeat(64),state:'pin_unknown',groupJid:jid});await store.pinned!('pin',key,'pin-ficticio');}finally{await a.$disconnect();}const b=new PrismaClient();try{const record=await operationStore(b).find('pin',key);assert.equal(record?.state,'pin_accepted');assert.equal(record?.messageId,'pin-ficticio');}finally{await b.$disconnect();}});
