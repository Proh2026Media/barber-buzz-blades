index 0000000..4bd4305
--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/bc-groups/cycle-store.ts
@@ -0,0 +1,206 @@
+import type { Prisma, PrismaClient } from '@prisma/client';
+
+import type { CycleStore, GroupCycle } from './cycle';
+const stored = (value: GroupCycle) => {
+  const copy = { ...value };
+  delete copy.lastMessages;
+  delete copy.lastWelcomeReceived;
+  delete copy.lastWelcomeAdmissionId;
+  return copy as unknown as Prisma.InputJsonValue;
+};
+/** CAS e provas persistentes, compartilhadas entre as instâncias da mesma composição. */
+export function cycleStore(db: PrismaClient): CycleStore {
+  const cycle: CycleStore['cycle'] = async (groupJid) => {
+    const row = await db.bcGroupCycle.findUnique({ where: { groupJid } });
+    if (!row) return null;
+    const c = { ...(row.data as unknown as GroupCycle), version: row.version };
+    let changed = false;
+    const scope = 'group:' + groupJid;
+    for (const [key, field] of [
+      [c.firstWelcomeOperation, 'firstMessageId'],
+      [c.lastWelcomeOperation, 'lastWelcomeMessageId'],
+    ] as const) {
+      if (!key) continue;
+      const op = await db.bcGroupOperation.findUnique({
+        where: { instanceId_operationKey: { instanceId: scope, operationKey: key } },
+      });
+      if (op?.state === 'notice_accepted' && op.groupJid === groupJid && op.messageId && c[field] !== op.messageId) {
+        c[field] = op.messageId;
+        changed = true;
+      }
+    }
+    if (c.photoIntent) {
+      const op = await db.bcGroupOperation.findUnique({
+        where: { instanceId_operationKey: { instanceId: scope, operationKey: c.photoIntent.key } },
+      });
+      if (op?.state === 'config_accepted' && op.groupJid === groupJid && c.logoHash !== c.photoIntent.hash) {
+        c.logoHash = c.photoIntent.hash;
+        c.logoApplied = true;
+        changed = true;
+      }
+    }
+    if (c.pinIntent) {
+      const op = await db.bcGroupOperation.findUnique({
+        where: { instanceId_operationKey: { instanceId: scope, operationKey: c.pinIntent.key } },
+      });
+      if (op?.state === 'pin_accepted' && op.groupJid === groupJid && op.requestHash === c.pinIntent.hash) {
+        const until = new Date(Date.parse(c.pinIntent.requestedAt) + c.pinIntent.duration * 1000).toISOString();
+        if (c.pinExpiresAt !== until || !c.pinAccepted) {
+          c.pinAccepted = true;
+          c.pinExpiresAt = until;
+          changed = true;
+        }
+      }
+    }
+    if (!c.firstReceived && c.firstMessageId && c.firstSenderJid && c.firstSenderJid !== c.creatorJid) {
+      const proof = await db.bcGroupEvidence.findUnique({
+        where: {
+          groupJid_messageId_observer_author: {
+            groupJid,
+            messageId: c.firstMessageId,
+            observer: c.creatorJid,
+            author: c.firstSenderJid,
+          },
+        },
+      });
+      if (proof) {
+        c.firstReceived = true;
+        changed = true;
+      }
+    }
+    if (
+      !c.firstViolation &&
+      (await db.bcGroupEvidence.findFirst({ where: { groupJid, prematureCreator: true }, select: { messageId: true } }))
+    ) {
+      c.firstViolation = true;
+      changed = true;
+    }
+    if (changed) {
+      const saved = await db.bcGroupCycle.updateMany({
+        where: { groupJid, version: c.version },
+        data: { version: { increment: 1 }, data: stored(c) },
+      });
+      if (saved.count !== 1) throw new Error('Conferência concorrente; consultar novamente');
+      c.version++;
+    }
+    const admissions = Object.entries(c.welcomeAdmissions ?? {}).filter(([, key]) => key === c.lastWelcomeOperation);
+    c.lastWelcomeAdmissionId = admissions.length === 1 ? admissions[0][0] : undefined;
+    c.lastWelcomeReceived = Boolean(
+      c.lastWelcomeMessageId &&
+        c.welcomeAuthorJid &&
+        (await db.bcGroupEvidence.findFirst({
+          where: {
+            groupJid,
+            messageId: c.lastWelcomeMessageId,
+            author: c.welcomeAuthorJid,
+            observer: { in: c.platformJids.filter((p) => p !== c.welcomeAuthorJid) },
+          },
+        })),
+    );
+    const ranges = await db.bcGroupAccountState.findMany({ where: { groupJid } });
+    c.lastMessages = Object.fromEntries(
+      ranges.map((r) => [r.accountJid, r.lastMessage as unknown as NonNullable<GroupCycle['lastMessages']>[string]]),
+    );
+    return c;
+  };
+  const saveCycle: CycleStore['saveCycle'] = async (value) => {
+    const updated = await db.bcGroupCycle.updateMany({
+      where: { groupJid: value.groupJid, version: value.version },
+      data: { version: { increment: 1 }, data: stored(value) },
+    });
+    if (updated.count !== 1) throw new Error('Ciclo alterado; conferir antes de continuar');
+    value.version++;
+  };
+  return {
+    cycle,
+    saveCycle,
+    minimizeClosed: async (c) => {
+      if (!c.closed || !c.closeProof || !c.platformJids.every((pn) => c.closeProof.deleted[pn]))
+        throw new Error('Limpeza ainda não comprovada');
+      const slim = {
+        ...c,
+        minimized: true,
+        customerJid: '',
+        firstMessageId: null,
+        firstWelcomeOperation: null,
+        firstSenderJid: null,
+        firstReceived: false,
+        lastWelcomeOperation: null,
+        lastWelcomeMessageId: null,
+      };
+      delete slim.brand;
+      delete slim.lastMessages;
+      delete slim.welcomeAdmissions;
+      delete slim.photoIntent;
+      delete slim.pinIntent;
+      await db.$transaction(async (tx) => {
+        const saved = await tx.bcGroupCycle.updateMany({
+          where: { groupJid: c.groupJid, version: c.version },
+          data: { version: { increment: 1 }, data: stored(slim) },
+        });
+        if (saved.count !== 1) throw new Error('Ciclo alterado durante minimização');
+        await tx.bcGroupEvidence.deleteMany({ where: { groupJid: c.groupJid } });
+        await tx.bcGroupAccountState.deleteMany({ where: { groupJid: c.groupJid } });
+      });
+      Object.assign(c, slim, { version: c.version + 1 });
+    },
+    createCycle: async (value) => {
+      try {
+        await db.bcGroupCycle.create({ data: { groupJid: value.groupJid, data: stored(value) } });
+        return true;
+      } catch (error) {
+        if (error?.code === 'P2002') return false;
+        throw error;
+      }
+    },
+    finish: async (instanceId, operationKey, state, messageId) => {
+      await db.bcGroupOperation.update({
+        where: { instanceId_operationKey: { instanceId, operationKey } },
+        data: { state, ...(messageId ? { messageId } : {}) },
+      });
+    },
+    evidence: async (jid, messageId, observer, author, common, range) => {
+      if (!messageId || messageId.length > 200) return;
+      const c = await cycle(jid);
+      if (!c || c.closed || !c.platformJids.includes(observer)) return;
+      if (common && c.platformJids.includes(author)) {
+        const prematureCreator = !c.closed && !c.firstReceived && author === c.creatorJid;
+        await db.bcGroupEvidence.upsert({
+          where: { groupJid_messageId_observer_author: { groupJid: jid, messageId, observer, author } },
+          create: { groupJid: jid, messageId, observer, author, prematureCreator },
+          update: {},
+        });
+      }
+      // Estado de leitura separado: novas mensagens não invalidam a versão das mutações.
+      if (
+        range &&
+        range.key.remoteJid === jid &&
+        range.key.id === messageId &&
+        Number.isSafeInteger(range.messageTimestamp) &&
+        range.messageTimestamp > 0 &&
+        range.messageTimestamp * 1000 <= Date.now() + 300000
+      ) {
+        const changed = await db.bcGroupAccountState.updateMany({
+          where: { groupJid: jid, accountJid: observer, messageTimestamp: { lte: BigInt(range.messageTimestamp) } },
+          data: {
+            lastMessage: range as unknown as Prisma.InputJsonValue,
+            messageTimestamp: BigInt(range.messageTimestamp),
+          },
+        });
+        if (!changed.count)
+          try {
+            await db.bcGroupAccountState.create({
+              data: {
+                groupJid: jid,
+                accountJid: observer,
+                messageTimestamp: BigInt(range.messageTimestamp),
+                lastMessage: range as unknown as Prisma.InputJsonValue,
+              },
+            });
+          } catch (error) {
+            if (error?.code !== 'P2002') throw error;
+          }
+      }
+    },
+  };
+}
diff --git a/src/api/integrations/channel/whatsapp/bc-groups/cycle.ts b/src/api/integrations/channel/whatsapp/bc-groups/cycle.ts
new file mode 100644
index 0000000..4f2fa2f
--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/bc-groups/cycle.ts
@@ -0,0 +1,156 @@
+/** Ciclo/provas minimizadas. Não armazena texto, código, QR ou convite. */
+export type GroupCycle = {
+  minimized?: boolean;
+  brand?: import('./content').GroupBrand;
+  photoIntent?: { key: string; hash: string };
+  pinIntent?: { key: string; duration: number; requestedAt: string; hash: string };
+  closeProof?: {
+    lastJid: string;
+    originalInviteHash?: string;
+    revoked: boolean;
+    removed: boolean;
+    leaveOps: Record<string, string>;
+    deleted: Record<string, boolean>;
+  };
+  inviteHash?: string;
+  lastMessages?: Record<
+    string,
+    { key: { remoteJid: string; id: string; fromMe: boolean; participant?: string }; messageTimestamp: number }
+  >;
+  welcomeAuthorJid?: string;
+  welcomeAdmissions?: Record<string, string>;
+  version: number;
+  groupJid: string;
+  customerJid: string;
+  platformJids: string[];
+  creatorJid: string;
+  creatorInstanceId: string;
+  createdAt: string;
+  expiresAt: string;
+  firstWelcomeOperation: string | null;
+  firstSenderJid: string | null;
+  firstMessageId: string | null;
+  firstReceived: boolean;
+  lastWelcomeReceived?: boolean;
+  lastWelcomeAdmissionId?: string;
+  firstViolation: boolean;
+  logoHash: string | null;
+  logoApplied: boolean;
+  prepared: boolean;
+  descriptionHash: string | null;
+  lastWelcomeMessageId: string | null;
+  lastWelcomeOperation: string | null;
+  pinExpiresAt: string | null;
+  pinAccepted: boolean;
+  closing: boolean;
+  closed: boolean;
+  leftInstances: string[];
+};
+export type CycleStore = {
+  cycle: (jid: string) => Promise<GroupCycle | null>;
+  createCycle: (cycle: GroupCycle) => Promise<boolean>;
+  saveCycle: (cycle: GroupCycle) => Promise<void>;
+  minimizeClosed: (cycle: GroupCycle) => Promise<void>;
+  finish: (namespace: string, key: string, state: string, messageId?: string) => Promise<void>;
+  evidence: (
+    jid: string,
+    messageId: string,
+    observer: string,
+    author: string,
+    common: boolean,
+    range?: { key: { remoteJid: string; id: string; fromMe: boolean; participant?: string }; messageTimestamp: number },
+  ) => Promise<void>;
+};
+export function cycleExpiry(creation: number) {
+  if (!Number.isSafeInteger(creation) || creation <= 0 || creation * 1000 > Date.now())
+    throw new Error('Criação sem prova');
+  const date = new Date(creation * 1000),
+    month = date.getUTCMonth();
+  date.setUTCFullYear(date.getUTCFullYear() + 1);
+  if (date.getUTCMonth() !== month) date.setUTCDate(0);
+  return date.toISOString();
+}
+export function phoneJid(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const normalized = value.replace(/:\d+@/, '@');
+  return /^[1-9][0-9]{7,14}@s\.whatsapp\.net$/.test(normalized) ? normalized : null;
+}
+export function memberPhone(p: { id?: unknown; phoneNumber?: unknown; lid?: unknown }): string | null {
+  const direct = phoneJid(p.id),
+    linked = phoneJid(p.phoneNumber);
+  const lid = typeof p.id === 'string' && /^[0-9]+@lid$/.test(p.id);
+  if (p.phoneNumber != null && (!linked || (direct && direct !== linked))) return null;
+  if (lid && p.lid != null && p.id !== p.lid) return null;
+  return direct ?? (lid ? linked : null);
+}
+export function cycleQuorum(cycle: GroupCycle, raw: unknown, allowAbsent = false, at = Date.now()) {
+  if (
+    !raw ||
+    typeof raw !== 'object' ||
+    cycle.closed ||
+    cycle.closing ||
+    cycle.firstViolation ||
+    !Number.isFinite(Date.parse(cycle.expiresAt)) ||
+    at >= Date.parse(cycle.expiresAt)
+  )
+    return false;
+  const group = raw as {
+    creation?: unknown;
+    id?: unknown;
+    restrict?: unknown;
+    memberAddMode?: unknown;
+    joinApprovalMode?: unknown;
+    participants?: { id?: unknown; phoneNumber?: unknown; admin?: unknown }[];
+  };
+  if (
+    !phoneJid(cycle.customerJid) ||
+    !phoneJid(cycle.creatorJid) ||
+    !cycle.platformJids.every(phoneJid) ||
+    typeof group.creation !== 'number' ||
+    !Number.isSafeInteger(group.creation) ||
+    group.creation <= 0 ||
+    group.creation * 1000 > Date.now() ||
+    group.creation * 1000 !== Date.parse(cycle.createdAt) ||
+    Date.parse(cycleExpiry(group.creation)) !== Date.parse(cycle.expiresAt)
+  )
+    return false;
+  if (
+    group.id !== cycle.groupJid ||
+    group.restrict !== true ||
+    group.memberAddMode !== false ||
+    group.joinApprovalMode !== true ||
+    !Array.isArray(group.participants) ||
+    cycle.platformJids.length < 2 ||
+    cycle.platformJids.length > 20 ||
+    new Set(cycle.platformJids).size !== cycle.platformJids.length ||
+    cycle.platformJids.includes(cycle.customerJid)
+  )
+    return false;
+  const seen = new Set<string>();
+  for (const p of group.participants) {
+    const pn = memberPhone(p);
+    if (!pn || seen.has(pn)) return false;
+    seen.add(pn);
+    if (cycle.platformJids.includes(pn)) {
+      if (p.admin !== 'admin' && p.admin !== 'superadmin') return false;
+    } else if (pn !== cycle.customerJid || p.admin != null) return false;
+  }
+  return cycle.platformJids.every((p) => seen.has(p)) && (allowAbsent || seen.has(cycle.customerJid));
+}
+export function cycleSendReady(cycle: GroupCycle, raw: unknown, at = Date.now()) {
+  return (
+    cycleQuorum(cycle, raw, false, at) &&
+    cycle.prepared &&
+    cycle.logoApplied &&
+    Boolean(cycle.descriptionHash) &&
+    cycle.pinAccepted &&
+    Number.isFinite(Date.parse(cycle.pinExpiresAt ?? '')) &&
+    Date.parse(cycle.pinExpiresAt!) > at &&
+    cycle.firstReceived &&
+    cycle.lastWelcomeReceived === true &&
+    Boolean(cycle.lastWelcomeAdmissionId) &&
+    Boolean(cycle.firstMessageId) &&
+    Boolean(cycle.firstSenderJid) &&
+    cycle.firstSenderJid !== cycle.creatorJid
+  );
+}
