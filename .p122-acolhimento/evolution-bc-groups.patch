@@ -0,0 +1,219 @@
+import sharp from 'sharp';
+/** Subconjunto vetorial autocontido. Não carrega URL, arquivo, fonte, entidade ou script. */
+export function validateGroupSvg(input: Buffer) {
+  let source = input
+    .toString('utf8')
+    .replace(/^\uFEFF/, '')
+    .trim();
+  if (
+    Buffer.from(source).includes(Buffer.from([0xef, 0xbf, 0xbd])) ||
+    source.length > 200000 ||
+    Array.from(source).some((c) => c.charCodeAt(0) < 32 && ![9, 10, 13].includes(c.charCodeAt(0))) ||
+    source.includes(String.fromCharCode(92)) ||
+    /&(?!(?:amp|lt|gt|apos|quot);)/.test(source)
+  )
+    throw Error('GROUP_LOGO_SVG_INVALID');
+  source = source
+    .replace(/^<\?xml\s+version=["']1\.0["'](?:\s+encoding=["']UTF-8["'])?\s*\?>\s*/i, '')
+    .replace(/<!--[\s\S]*?-->/g, '');
+  if (/<[!?]/.test(source)) throw Error('GROUP_LOGO_SVG_INVALID');
+  const tags = new Set([
+    'svg',
+    'g',
+    'path',
+    'circle',
+    'ellipse',
+    'rect',
+    'line',
+    'polyline',
+    'polygon',
+    'defs',
+    'linearGradient',
+    'radialGradient',
+    'stop',
+    'clipPath',
+    'title',
+    'desc',
+  ]);
+  const geometry = new Set([
+    'x',
+    'y',
+    'x1',
+    'x2',
+    'y1',
+    'y2',
+    'cx',
+    'cy',
+    'r',
+    'rx',
+    'ry',
+    'fx',
+    'fy',
+    'fr',
+    'width',
+    'height',
+    'viewBox',
+    'stroke-width',
+    'stroke-dasharray',
+    'stroke-dashoffset',
+    'stroke-miterlimit',
+    'offset',
+  ]);
+  const enums: Record<string, string[]> = {
+    'fill-rule': ['nonzero', 'evenodd'],
+    'clip-rule': ['nonzero', 'evenodd'],
+    'stroke-linecap': ['butt', 'round', 'square'],
+    'stroke-linejoin': ['miter', 'round', 'bevel'],
+    gradientUnits: ['userSpaceOnUse', 'objectBoundingBox'],
+    clipPathUnits: ['userSpaceOnUse', 'objectBoundingBox'],
+    spreadMethod: ['pad', 'reflect', 'repeat'],
+    'vector-effect': ['none', 'non-scaling-stroke'],
+    display: ['none', 'inline'],
+    visibility: ['visible', 'hidden'],
+  };
+  const ids = new Map<string, string>(),
+    refs: { id: string; kind: string }[] = [],
+    stack: string[] = [];
+  let nodes = 0,
+    cursor = 0,
+    root = false;
+  const numbers = (value: string) =>
+    /^[\d\s.,+eE%-]+$/.test(value) &&
+    (value.match(/[+-]?(?:\d*\.)?\d+(?:[eE][+-]?\d+)?/g) ?? []).every(
+      (n) => Number.isFinite(Number(n)) && Math.abs(Number(n)) <= 1000000,
+    );
+  function attribute(name: string, value: string, tag: string) {
+    if (name === 'xmlns') return tag === 'svg' && value === 'http://www.w3.org/2000/svg';
+    if (name === 'role') return value === 'img';
+    if (['aria-label', 'aria-labelledby'].includes(name)) return value.length <= 200 && !/[<>]/.test(value);
+    if (name === 'id') {
+      if (!/^[A-Za-z_][A-Za-z0-9_.-]{0,99}$/.test(value) || ids.has(value)) return false;
+      ids.set(value, tag);
+      return true;
+    }
+    if (name === 'version') return tag === 'svg' && value === '1.1';
+    if (name === 'preserveAspectRatio')
+      return /^(?:none|x(?:Min|Mid|Max)Y(?:Min|Mid|Max)(?: (?:meet|slice))?)$/.test(value);
+    if (geometry.has(name)) return (value === 'none' && name === 'stroke-dasharray') || numbers(value);
+    if (['opacity', 'fill-opacity', 'stroke-opacity', 'stop-opacity'].includes(name))
+      return /^\d*(?:\.\d+)?$/.test(value) && Number(value) >= 0 && Number(value) <= 1;
+    if (name === 'd')
+      return (
+        value.length <= 100000 &&
+        /^[MmLlHhVvCcSsQqTtAaZz\d\s.,+eE-]+$/.test(value) &&
+        numbers(value.replace(/[MmLlHhVvCcSsQqTtAaZz]/g, ' '))
+      );
+    if (name === 'points') return numbers(value);
+    if (name === 'transform' || name === 'gradientTransform')
+      return (
+        value.length <= 1000 &&
+        /^(?:\s*(?:matrix|translate|scale|rotate|skewX|skewY)\s*\([\d\s.,+eE-]+\)\s*)+$/.test(value) &&
+        numbers(value.replace(/\b(?:matrix|translate|scale|rotate|skewX|skewY)\b|[()]/g, ' '))
+      );
+    if (Object.prototype.hasOwnProperty.call(enums, name)) return enums[name].includes(value);
+    if (['fill', 'stroke', 'stop-color', 'clip-path'].includes(name)) {
+      const ref = /^url\(\s*#([A-Za-z_][A-Za-z0-9_.-]{0,99})\s*\)$/.exec(value);
+      if (ref) {
+        if (
+          stack.includes('clipPath') ||
+          ['clipPath', 'linearGradient', 'radialGradient', 'stop', 'defs'].includes(tag) ||
+          name === 'stop-color'
+        )
+          return false;
+        refs.push({ id: ref[1], kind: name === 'clip-path' ? 'clip' : 'gradient' });
+        return true;
+      }
+      return (
+        name !== 'clip-path' &&
+        /^(?:#[a-fA-F0-9]{3,8}|[a-zA-Z]{1,24}|(?:rgb|rgba|hsl|hsla)\([\d\s.,%+-]+\))$/.test(value)
+      );
+    }
+    if (name === 'style') {
+      const declarations = value.split(';').filter((p) => p.trim());
+      return (
+        declarations.length <= 20 &&
+        declarations.every((p) => {
+          const parts = p.split(':');
+          const key = parts[0].trim();
+          return (
+            parts.length === 2 &&
+            key !== 'style' &&
+            key !== 'id' &&
+            key !== 'xmlns' &&
+            attribute(key, parts[1].trim(), tag)
+          );
+        })
+      );
+    }
+    return false;
+  }
+  const tokens = /<[^<>]*>/g;
+  let token: RegExpExecArray | null;
+  while ((token = tokens.exec(source))) {
+    const text = source.slice(cursor, token.index);
+    if (text.trim() && !['title', 'desc'].includes(stack[stack.length - 1] ?? ''))
+      throw Error('GROUP_LOGO_SVG_INVALID');
+    cursor = tokens.lastIndex;
+    const close = /^<\/([A-Za-z][A-Za-z0-9]*)\s*>$/.exec(token[0]);
+    if (close) {
+      if (stack.pop() !== close[1]) throw Error('GROUP_LOGO_SVG_INVALID');
+      continue;
+    }
+    const open = /^<([A-Za-z][A-Za-z0-9]*)([\s\S]*?)(\/?)>$/.exec(token[0]);
+    if (!open || !tags.has(open[1]) || ++nodes > 1000 || stack.length >= 32) throw Error('GROUP_LOGO_SVG_INVALID');
+    const tag = open[1];
+    if (!root) {
+      if (tag !== 'svg') throw Error('GROUP_LOGO_SVG_INVALID');
+      root = true;
+    } else if (!stack.length || tag === 'svg') throw Error('GROUP_LOGO_SVG_INVALID');
+    const tail = open[2];
+    let at = 0;
+    const seen = new Set<string>();
+    const attrs = /\s+([A-Za-z][A-Za-z0-9:-]*)\s*=\s*(?:"([^"]*)"|'([^']*)')/gy;
+    let match: RegExpExecArray | null;
+    while (at < tail.length) {
+      attrs.lastIndex = at;
+      match = attrs.exec(tail);
+      if (!match) {
+        if (tail.slice(at).trim()) throw Error('GROUP_LOGO_SVG_INVALID');
+        break;
+      }
+      at = attrs.lastIndex;
+      if (seen.has(match[1]) || !attribute(match[1], match[2] ?? match[3], tag)) throw Error('GROUP_LOGO_SVG_INVALID');
+      seen.add(match[1]);
+    }
+    if (!open[3]) stack.push(tag);
+  }
+  if (
+    !root ||
+    stack.length ||
+    source.slice(cursor).trim() ||
+    refs.some((r) =>
+      r.kind === 'clip'
+        ? ids.get(r.id) !== 'clipPath'
+        : !['linearGradient', 'radialGradient'].includes(ids.get(r.id) ?? ''),
+    )
+  )
+    throw Error('GROUP_LOGO_SVG_INVALID');
+  return Buffer.from(source);
+}
+export async function groupPhoto(bytes: Buffer) {
+  if (!bytes.length || bytes.length > 2097152) throw Error('GROUP_LOGO_INVALID');
+  const text = bytes.subarray(0, 512).toString('utf8').trimStart();
+  const input = text.startsWith('<') || text.startsWith('\uFEFF') ? validateGroupSvg(bytes) : bytes;
+  const image = sharp(input, { limitInputPixels: 4194304, failOn: 'error' });
+  const info = await image.metadata();
+  if (
+    !['png', 'jpeg', 'webp', 'svg'].includes(info.format) ||
+    !info.width ||
+    !info.height ||
+    info.width * info.height > 4194304
+  )
+    throw Error('GROUP_LOGO_FORMAT');
+  return image
+    .rotate()
+    .resize(512, 512, { fit: 'contain', background: '#ffffff' })
+    .jpeg({ quality: 90 })
+    .timeout({ seconds: 3 })
+    .toBuffer();
+}
