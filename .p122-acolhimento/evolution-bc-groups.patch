+process.env.BC_GROUPS_EXTENSION_ENABLED='true';process.env.BC_GROUPS_INSTANCES='fixture';
+const request=()=>({operationId:key(1),cycleId:key(100),subject:'Notificações Arena • Cliente',participants:[b],customerJid:u,brand:branding});
+const rejects=(fn:()=>Promise<unknown>,status:number)=>assert.rejects(fn,(e:any)=>e.status===status);
+async function prepared(){const f=await fixture();await f.create();await executeGroupCommand(f.d,'prepare',f.preparation);f.raw.participants.push({id:u,admin:null});f.as(b);const w=await executeGroupCommand(f.d,'welcome',{groupJid:id,operationId:key(3),admissionId:key(101)}) as any;await executeGroupCommand(f.d,'description',{groupJid:id});await executeGroupCommand(f.d,'pinNotice',{groupJid:id,operationId:key(4),messageId:w.messageId,duration:2592000});await f.d.cycles.evidence(id,w.messageId,a,b,true);return f;}
+const code=()=>({operationId:key(5),groupJid:id,customerJid:u,platformJids:[a,b],purpose:'login',expiresAt:new Date(Date.now()+60000).toISOString(),code:'654321'});
+test('Flags fechadas por padrão; instância gerenciada exige UUID exato e duas flags',()=>{
+ assert.equal(extensionEnabled('fixture',{}),false);assert.equal(extensionEnabled('outra'),false);
+ const name='bc-11111111-1111-4111-8111-111111111111';assert.equal(extensionEnabled(name,{BC_GROUPS_EXTENSION_ENABLED:'true'}),false);assert.equal(extensionEnabled(name,{BC_GROUPS_EXTENSION_ENABLED:'true',BC_GROUPS_MANAGED_INSTANCES:'true'}),true);assert.equal(extensionEnabled(name+'x',{BC_GROUPS_EXTENSION_ENABLED:'true',BC_GROUPS_MANAGED_INSTANCES:'true'}),false);
+ assert.deepEqual(configuredPlatformJids('fixture',{BC_GROUPS_PLATFORM_JIDS:'invalido'}),[]);
+});
+test('Instância ou identidade não autorizada nunca chega ao provedor',async()=>{for(const mode of ['instancia','conta','offline']){const f=await fixture();if(mode==='instancia')f.d.instanceName='outra';if(mode==='conta')f.d.platformJids=[];if(mode==='offline')f.d.ready=()=>false;await rejects(()=>executeGroupCommand(f.d,'create',request()),503);assert.equal(f.creates(),0);}});
+test('Cliente não pode ser plataforma; campo extra ou apenas um número são recusados',async()=>{for(const patch of [{participants:[]},{participants:[u]},{promoteParticipants:true}]){const f=await fixture();await rejects(()=>executeGroupCommand(f.d,'create',{...request(),...patch}),400);assert.equal(f.creates(),0);}});
+test('Concorrência e reinício conservam uma única criação',async()=>{const f=await fixture();await Promise.allSettled(Array.from({length:10},()=>executeGroupCommand(f.d,'create',request())));assert.equal(f.creates(),1);assert.equal((await executeGroupCommand({...f.d},'create',request()) as any).groupJid,id);assert.equal(f.creates(),1);});
+test('Nonce não aceita outro conteúdo; banco antes da licença impede criação',async()=>{const f=await fixture();await executeGroupCommand(f.d,'create',request());await rejects(()=>executeGroupCommand(f.d,'create',{...request(),subject:'Outro'}),409);assert.equal(f.creates(),1);const g=await fixture();g.d.store.claim=async()=>{throw Error('falha fictícia');};await assert.rejects(()=>executeGroupCommand(g.d,'create',request()));assert.equal(g.creates(),0);});
+test('Criação incerta ou falha ao persistir o JID não transmite outra vez',async()=>{for(const mode of ['rede','banco']){const f=await fixture();let calls=0;f.d.socket.groupCreate=async()=>{calls++;if(mode==='rede')throw Error('timeout fictício');return {id} as any;};if(mode==='banco')f.d.store.created=async()=>{throw Error('falha fictícia');};assert.equal((await executeGroupCommand(f.d,'create',request()) as any).state,'unknown');await executeGroupCommand(f.d,'create',request());assert.equal(calls,1);}});
+test('Consulta por instância não revela operação de outra conta',async()=>{const f=await fixture();await executeGroupCommand(f.d,'create',request());f.d.instanceId='outra';await rejects(()=>executeGroupCommand(f.d,'createStatus',{operationId:key(1)}),404);});
+test('Rotas genéricas não podem contornar preparação e composição',async()=>{const f=await fixture();for(const command of ['memberMode','approvalMode','setting','member'])await rejects(()=>executeGroupCommand(f.d,command,{groupJid:id}),403);assert.equal(f.creates(),0);});
+test('Inspeção exige JID exato, PN sem conflito e admin real',async()=>{for(const mode of ['id','pn','admin']){const f=await fixture();if(mode==='id')f.raw.id='999@g.us';if(mode==='pn')f.raw.participants[0].phoneNumber=b;if(mode==='admin')f.raw.participants[0].admin=null;await rejects(()=>executeGroupCommand(f.d,'inspect',{groupJid:id}),mode==='id'?409:403);}});
+test('Metadados ausentes não viram proteção; LID sem prova não vira telefone',()=>{assert.equal(groupView({id,participants:[]} as any).joinApprovalMode,null);assert.equal(participantIdentity('123456@lid').phoneNumber,null);assert.equal(participantIdentity({id:'123456@lid',phoneNumber:'123456'}).phoneNumber,null);assert.equal(participantIdentity({id:'123456@lid',phoneNumber:b}).phoneNumber,b);assert.equal(participantIdentity({id:a,phoneNumber:b}).phoneNumber,null);});
+test('Envelope só para eventos/instâncias protegidos, versão nova explícita',()=>{assert.deepEqual(eventEnvelope('outra','groups.update'),{});assert.deepEqual(eventEnvelope('fixture','messages.upsert'),{});const e=eventEnvelope('fixture','group-participants.update');assert.match(e.event_id!,/^[a-f0-9-]{36}$/);assert.equal(e.contract_version,'bc-groups-v4');});
+test('OTP: diário global entre contas; concorrência não duplica nem guarda o código',async()=>{const f=await prepared();const start=f.sent.length;const r=code();await Promise.allSettled(Array.from({length:8},()=>executeGroupCommand(f.d,'sendCode',r)));assert.equal(f.sent.length,start+1);f.as(a);await rejects(()=>executeGroupCommand(f.d,'sendCode',r),409);assert.equal(f.sent.length,start+1);assert.ok(!JSON.stringify([...f.map.values()]).includes('654321'));});
+test('OTP não tolera intruso, cliente admin/ausente, proteção ausente ou validade vencida',async()=>{for(const mode of ['intruso','admin','ausente','controle','expirado']){const f=await prepared();if(mode==='intruso')f.raw.participants.push({id:'5511666666666@s.whatsapp.net',admin:null});if(mode==='admin')f.raw.participants.find(p=>p.id===u).admin='admin';if(mode==='ausente')f.raw.participants=f.raw.participants.filter(p=>p.id!==u);if(mode==='controle')f.raw.joinApprovalMode=false;const r=code();if(mode==='expirado')r.expiresAt='2020-01-01T00:00:00Z';const count=f.sent.length;await assert.rejects(()=>executeGroupCommand(f.d,'sendCode',r));assert.equal(f.sent.length,count);}});
