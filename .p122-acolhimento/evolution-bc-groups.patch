--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/bc-groups/cycle-evidence.ts
@@ -0,0 +1,86 @@
+import { type CycleStore, memberPhone } from './cycle';
+import { type PhoneResolver, resolvePhone } from './cycle-identity';
+const group = (value: unknown): value is string =>
+  typeof value === 'string' && /^[0-9-]+@g\.us$/.test(value) && value.length <= 128;
+const observer = async (self: unknown[], lookup?: PhoneResolver) => {
+  for (const value of self) {
+    if (typeof value === 'string') {
+      const phone = await resolvePhone(value, lookup);
+      if (phone) return phone;
+    }
+  }
+  return null;
+};
+/** Executado no evento interno autenticado do socket, antes de descartar texto de OTP. */
+export async function captureCycleMessage(store: CycleStore, self: unknown[], message: any, lookup?: PhoneResolver) {
+  const id = message?.key?.remoteJid,
+    key = message?.key?.id,
+    who = await observer(self, lookup);
+  if (!group(id) || !who || typeof key !== 'string' || !key || key.length > 200) return;
+  const author = message.key.fromMe
+    ? who
+    : (memberPhone({ id: message.key.participant, phoneNumber: message.key.participantAlt }) ??
+      (message.key.participantAlt == null && typeof message.key.participant === 'string'
+        ? await resolvePhone(message.key.participant, lookup)
+        : null));
+  const body = message?.message;
+  const common = Boolean(
+    body &&
+      [
+        'conversation',
+        'extendedTextMessage',
+        'imageMessage',
+        'videoMessage',
+        'audioMessage',
+        'documentMessage',
+        'stickerMessage',
+        'contactMessage',
+        'locationMessage',
+      ].some((k) => body[k] != null),
+  );
+  const raw = message?.messageTimestamp;
+  const timestamp = typeof raw === 'number' ? raw : typeof raw?.toNumber === 'function' ? raw.toNumber() : null;
+  const source = message.key.participant;
+  const participant =
+    typeof source === 'string' && /^[0-9]+(?::[0-9]+)?@(s\.whatsapp\.net|lid)$/.test(source) && source.length <= 40
+      ? source
+      : undefined;
+  const range =
+    Number.isSafeInteger(timestamp) && timestamp > 0
+      ? {
+          key: { remoteJid: id, id: key, fromMe: message.key.fromMe === true, ...(participant ? { participant } : {}) },
+          messageTimestamp: timestamp,
+        }
+      : undefined;
+  await store.evidence(id, key, who, author ?? '', common, range);
+}
+/** Recibo é prova de recebimento somente quando contém identidade PN e horário válidos. */
+export async function captureCycleReceipts(
+  store: CycleStore,
+  self: unknown[],
+  events: unknown,
+  lookup?: PhoneResolver,
+) {
+  const author = await observer(self, lookup);
+  if (!author || !Array.isArray(events) || events.length > 1000) return;
+  for (const event of events.slice(0, 50)) {
+    const id = event?.key?.remoteJid,
+      key = event?.key?.id,
+      receipt = event?.receipt;
+    const who = typeof receipt?.userJid === 'string' ? await resolvePhone(receipt.userJid, lookup) : null;
+    const at = receipt?.receiptTimestamp ?? receipt?.readTimestamp;
+    if (
+      !group(id) ||
+      !who ||
+      typeof key !== 'string' ||
+      !key ||
+      key.length > 200 ||
+      typeof at !== 'number' ||
+      !Number.isFinite(at) ||
+      at <= 0 ||
+      at * 1000 > Date.now() + 300000
+    )
+      continue;
+    await store.evidence(id, key, who, author, true);
+  }
+}
diff --git a/src/api/integrations/channel/whatsapp/bc-groups/cycle-identity.ts b/src/api/integrations/channel/whatsapp/bc-groups/cycle-identity.ts
new file mode 100644
index 0000000..948d6bb
--- /dev/null
+++ b/src/api/integrations/channel/whatsapp/bc-groups/cycle-identity.ts
@@ -0,0 +1,37 @@
+import type { GroupMetadata } from 'baileys';
+
+import { phoneJid } from './cycle';
+export type PhoneResolver = (jid: string) => Promise<string | null>;
+export async function resolvePhone(jid: string, lookup?: PhoneResolver) {
+  const direct = phoneJid(jid);
+  if (direct) return direct;
+  if (!/^[0-9]+@lid$/.test(jid) || !lookup) return null;
+  let timer: ReturnType<typeof setTimeout>;
+  try {
+    const value = await Promise.race([
+      lookup(jid),
+      new Promise<null>((r) => {
+        timer = setTimeout(() => r(null), 1500);
+      }),
+    ]);
+    return phoneJid(value);
+  } catch {
+    return null;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+/** Apenas mapeamento autoritativo do socket. Campos conflitantes nunca são corrigidos por suposição. */
+export async function resolveGroupMetadata(raw: GroupMetadata, lookup?: PhoneResolver) {
+  if (!raw || !Array.isArray(raw.participants) || raw.participants.length > 21)
+    throw new Error('Metadados de grupo não comprovados');
+  const participants = await Promise.all(
+    raw.participants.map(async (p) => {
+      if (p.phoneNumber != null || !/^[0-9]+@lid$/.test(p.id)) return p;
+      const phoneNumber = await resolvePhone(p.id, lookup);
+      return phoneNumber ? { ...p, phoneNumber } : p;
+    }),
+  );
+  const ownerPn = raw.ownerPn ?? (typeof raw.owner === 'string' ? await resolvePhone(raw.owner, lookup) : null);
+  return { ...raw, participants, ...(ownerPn ? { ownerPn } : {}) };
+}
diff --git a/src/api/integrations/channel/whatsapp/bc-groups/cycle-store.ts b/src/api/integrations/channel/whatsapp/bc-groups/cycle-store.ts
